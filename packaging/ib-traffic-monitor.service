[Unit]
Description=InfiniBand Traffic Monitor Prometheus exporter
Documentation=https://github.com/NVIDIA/ib-traffic-monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
EnvironmentFile=-/etc/default/ib-traffic-monitor
ExecStart=/usr/bin/ib-traffic-monitor --daemon $IB_TRAFFIC_MONITOR_ARGS
Restart=on-failure
RestartSec=5s

# the exporter only reads world-readable files under /sys/class/infiniband
DynamicUser=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
